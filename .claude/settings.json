{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "Write(./**)",
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)",
      "Bash(tar -xf:*)",
      "Bash(git status:*)",
