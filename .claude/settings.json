{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git push -u origin issue-:*)",
      "Bash(git push origin issue-:*)",
      "Bash(git push --force-with-lease origin issue-:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh api repos/4OH4/news-bot/:*)",
      "Bash(python3 scripts/lead.py:*)",
      "Bash(python3 scripts/board.py:*)",
      "Bash(docker build:*)",
      "Bash(docker run --rm:*)",
      "Bash(docker image ls:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force origin:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gcloud:*)",
      "Bash(terraform:*)",
      "Read(./.env)",
      "Edit(./eval/urls.yaml)",
      "Write(./eval/urls.yaml)"
    ]
  }
}
