      "Bash(git worktree remove -f:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gcloud secrets:*)",
      "Bash(gcloud iam:*)",
      "Bash(gcloud billing:*)",
      "Bash(gcloud auth:*)",
