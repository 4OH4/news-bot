# Copy to .env for local overrides (.env is git-ignored). Never put secrets in this file.
# The Makefile sets the first two to absolute paths in the repo.

# Directory holding sources.yaml, interests.yaml and extraction.yaml
NEWSFEED_CONFIG_DIR=./config
# Local pipeline output: SQLite database, article HTML, previews
NEWSFEED_DATA_DIR=./data
# Evaluation page snapshots; must be outside the git working tree
NEWSFEED_FIXTURES_DIR=~/.newsfeed/eval-fixtures
