# Allowlist: only what the image needs is sent to the build context. It must stay
# an allowlist: in deploy.yml the auth step writes a credentials file
# (gha-creds-*.json) into the workspace before the build.
*
!backend/pyproject.toml
!backend/uv.lock
!backend/.python-version
!backend/src/
!config/
!client/
# Local env files hold developer settings; never send them.
client/.env*
# The client stage installs and builds its own; never send local copies.
client/node_modules/
client/dist/
client/.e2e/
client/test-results/
client/playwright-report/
**/gha-creds-*.json
**/__pycache__
**/*.py[cod]
